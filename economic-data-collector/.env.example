DATABASE_URL=postgres://econ:econ@localhost:5433/econdata

# Firecrawl (news collector)
FIRECRAWL_API_KEY=fc-your-key-here
FIRECRAWL_API_URL=https://api.firecrawl.dev

# ECOS - Bank of Korea macro indicators
# Apply for a free key at https://ecos.bok.or.kr/api/
ECOS_API_KEY=
ECOS_API_URL=https://ecos.bok.or.kr/api

# Slack alerts (optional)
SLACK_WEBHOOK_URL=
ALERT_FX_PCT=0.5
ALERT_INDEX_PCT=1.5
ALERT_COOLDOWN_MIN=30

LOG_LEVEL=info
TZ=Asia/Seoul

FX_CRON=*/1 * * * *
INDICES_CRON=*/5 * * * *
NEWS_CRON=0 * * * *
MACRO_CRON=0 9 * * *

{
  "name": "economic-data-collector",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time economic data collector: FX, market indices, and news headlines into PostgreSQL/TimescaleDB",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx scripts/migrate.ts",
    "collect:once": "tsx src/index.ts --once"
  },
  "dependencies": {
    "@mendable/firecrawl-js": "^1.20.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "yahoo-finance2": "^3.14.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}

{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "uid": "econ-overview",
  "title": "Economic Data Overview",
  "tags": ["econ", "firecrawl"],
  "timezone": "Asia/Seoul",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "FX Rates",
      "datasource": { "type": "postgres", "uid": "EconData" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "min", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('1 minute', ts) AS time, symbol AS metric, last(price, ts) AS value FROM fx_rates WHERE $__timeFilter(ts) GROUP BY time, symbol ORDER BY time"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Market Indices",
      "datasource": { "type": "postgres", "uid": "EconData" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "min", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('5 minutes', ts) AS time, name AS metric, last(price, ts) AS value FROM market_indices WHERE $__timeFilter(ts) GROUP BY time, name ORDER BY time"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latest FX",
      "datasource": { "type": "postgres", "uid": "EconData" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.5 }]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT DISTINCT ON (symbol) ts AS time, symbol, price FROM fx_rates ORDER BY symbol, ts DESC"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Latest Indices (% change)",
      "datasource": { "type": "postgres", "uid": "EconData" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": -0.5 },
              { "color": "green", "value": 0 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT DISTINCT ON (name) ts AS time, name, change_pct FROM market_indices ORDER BY name, ts DESC"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Recent Economic News",
      "datasource": { "type": "postgres", "uid": "EconData" },
      "gridPos": { "h": 10, "w": 16, "x": 0, "y": 15 },
      "options": { "showHeader": true },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "url" },
            "properties": [{ "id": "custom.cellOptions", "value": { "type": "json-view" } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT ts AS time, region, source, title, url FROM economic_news ORDER BY ts DESC LIMIT 50"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Recent Alerts",
      "datasource": { "type": "postgres", "uid": "EconData" },
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 15 },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT ts AS time, kind, symbol, change_pct, price FROM alerts_sent ORDER BY ts DESC LIMIT 50"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Korea Macro (ECOS)",
      "datasource": { "type": "postgres", "uid": "EconData" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 25 },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 5 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT ts AS time, name AS metric, value FROM macro_indicators ORDER BY ts"
        }
      ]
    }
  ]
}
